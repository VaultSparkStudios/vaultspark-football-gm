async function assertMeasuredRig(locator,player,mode=null){
 const actual=await locator.locator(mode?'.motion-upper-surface,.motion-lower-surface':'.physique-arm,.physique-leg').evaluateAll(elements=>elements.map(el=>el.getAttribute('d')));
 const expected=await locator.page().evaluate(async({player,mode})=>{
  const svg=mode?(await import('./lib/playerMotion.js')).buildPlayerMotionSvg(player,{mode,phase:0}):(await import('./lib/playerPortrait.js')).buildPlayerPhysiqueSvg(player);
  const template=document.createElement('template');template.innerHTML=svg;
  if(mode){
   const pose=(await import('./lib/playerMotion.js')).solvePlayerMotion(player,{mode,phase:0});
   const distance=(a,b)=>Math.hypot(a.x-b.x,a.y-b.y,(a.z??0)-(b.z??0));
   const f=player.visualFrame;
   if(Math.abs(distance(pose.arms[0].root,pose.arms[1].root)-f.shoulderSpanInches*6)>1e-8)throw Error('Shoulder spacing');
   for(const [limbs,total,share]of [[pose.arms,f.armSegmentLengthInches*6,f.upperArmShare],[pose.legs,f.legLengthInches*6,f.upperLegShare]])for(const limb of limbs){
    if(Math.abs(distance(limb.root,limb.joint)-total*share)>1e-8||Math.abs(distance(limb.joint,limb.end)-total*(1-share))>1e-8)throw Error('Bone length');
   }
  }
  return [...template.content.querySelectorAll(mode?'.motion-upper-surface,.motion-lower-surface':'.physique-arm,.physique-leg')].map(el=>el.getAttribute('d'));
 },{player,mode});
 expect(actual).toEqual(expected);expect(actual).toHaveLength(mode?8:4);
 if(!mode)await expect(locator.locator('[data-rig="measured-body-rig-v1"]')).toHaveCount(4);
}
