  "findings": [
    {
      "id": "malformed-grade-boundary",
      "verdict": "pass",
      "detail": "All four baseline panels falsely mark an away-winner prediction green and exact although the displayed actual winner is the home club. All four staging panels show No prediction submitted and zero graded totals instead; the malformed record earns no result."
    },
    {
      "id": "quota-grade-deduplication",
      "verdict": "pass",
      "detail": "All four recovered baseline panels display2/2 winner counts from the replayed write failure. All four staging panels display1/1, streak1 and one correct exact-margin result; recovered valid evidence remains visible."
    },
    {
      "id": "native-styles-and-theme-parity",
      "verdict": "pass",
      "detail": "Each device/theme/state was viewed individually. Native panel backgrounds, typography, muted stats and winner result styling remain present. Mobile stats and result sentences wrap inside the panel; no result text is clipped horizontally."
    },
    {
      "id": "fixed-topbar-capture-occlusion",
