import {test,expect} from '@playwright/test';
import fs from 'node:fs/promises';
import {fixture} from '../test/helpers/regularMedicalFixture.js';
import {expandSnapshotPensionService} from '../src/runtime/pensionServiceSnapshot.js';
import {startStaticClientHost,configureClient,createClientLeague,readClient,assertRuntime,saveSlot,waitGameReady} from './helpers/static-client.js';
let host;
test.beforeAll(async()=>{host=await startStaticClientHost();});
test.afterAll(async()=>{await host?.close();});
for(const worker of [true,false])test(`built ${worker?'worker':'in-page'} regular continuation reconciles actual practice pay and named saves`,async({page})=>{
 test.setTimeout(180000);
 const {s,l,p}=fixture();p.injury.weeksRemaining=3;l.teamCapOverride.BUF=1e9;
 p.id='imported-player-'+'X'.repeat(120);
 const right=l.admittedInjuryContinuations[0];right.playerId=p.id;right.rightId=JSON.stringify([p.id,right.gameId]);
 const outgoing=l.players.find(row=>row.teamId==='BUF'&&row.rosterSlot==='practice'&&!row.injury?.weeksRemaining);
 await configureClient(page,worker);await createClientLeague(page,host.origin,{seed:118,year:2027,team:'BUF',mode:'play'});await assertRuntime(page,worker);
 const result=await page.evaluate(async({snapshot,playerId,outgoingId})=>{
  const {api}=await import('./lib/appState.js');
  await api('/api/snapshot/import',{method:'POST',body:{snapshot}});
  const release=await api('/api/release',{method:'POST',body:{teamId:'BUF',playerId:outgoingId}});
  const signing=await api('/api/sign',{method:'POST',body:{teamId:'BUF',playerId,rosterSlot:'practice'}});
  const advance=await api('/api/advance-week',{method:'POST',body:{count:1}});
  await(await import('./lib/gameFlow.js')).loadState();
  return {release,signing,advance,snapshot:(await api('/api/snapshot/export')).snapshot};
 },{snapshot:s.toSnapshot(),playerId:p.id,outgoingId:outgoing.id});
 expect(result.release.ok).toBe(true);expect(result.signing.ok).toBe(true);expect(result.advance.ok).toBe(true);
 const snapshot=result.snapshot,person=snapshot.league.players.find(row=>row.id===p.id),row=snapshot.league.admittedInjuryPayroll.find(row=>row.playerId===p.id);
 expect(row).toMatchObject({version:'admitted-injury-earning-period-v3',teamId:'BUF',injuryYear:2026,earningYear:2027,phase:'regular-season',week:1,grossCents:2861111,practiceCents:1450000,amountCents:1411111});
 expect(person.contract.payLedger['2027:1'].amount*100+row.amountCents).toBe(row.grossCents);
 // Export uses the pension dictionary; its public profile resolves the earned
 // game independently from salary/free-agency service.
 const resolved=await readClient(page,`/api/player?playerId=${encodeURIComponent(p.id)}`);
 expect(resolved.profile.player.service.pension.observedSeasons).toBe(0);
 const proof=expandSnapshotPensionService(snapshot).league.players.find(person=>person.id===p.id).pensionService.planYears[2027].games[0];
 expect(proof).toMatchObject({reason:'admitted-injury-continuation',teamId:'BUF',sourceRef:row.payId});
 expect(proof.sourceRef.length).toBeGreaterThan(180);
 const slot=`admitted-reconciled-${worker?'worker':'in-page'}`;await saveSlot(page,slot);
 await page.evaluate(async()=>{const {api}=await import('./lib/appState.js');await api('/api/new-league',{method:'POST',body:{seed:118,startYear:2027,controlledTeamId:'MIA',mode:'play'}});await(await import('./lib/gameFlow.js')).loadState();});
 expect((await readClient(page,'/api/state')).controlledTeamId).toBe('MIA');
 await page.locator('[data-testid="tab-settings"]').click();await expect(page.locator('#settingsTab')).not.toHaveAttribute('aria-busy','true');
 await page.locator('#saveSlotInput').fill(slot);await page.locator('#loadBtn').click();await expect.poll(async()=>(await readClient(page,'/api/state')).controlledTeamId).toBe('BUF');
 await page.reload();await waitGameReady(page);await assertRuntime(page,worker);
 const restored=(await readClient(page,'/api/snapshot/export')).snapshot;
 expect(restored.league.admittedInjuryPayroll).toEqual(snapshot.league.admittedInjuryPayroll);
 expect(restored.league.capLedger.BUF.admittedInjuryCharges).toEqual(snapshot.league.capLedger.BUF.admittedInjuryCharges);
 expect(restored.league.players.find(row=>row.id===p.id).contract).toEqual(person.contract);
 expect(restored.pensionServiceStorage).toEqual(snapshot.pensionServiceStorage);
 const manifest=JSON.parse(await fs.readFile('static/deploy-manifest.json','utf8'));
 await fs.mkdir('.cache/admitted-reconciled-client',{recursive:true});
 await fs.writeFile(`.cache/admitted-reconciled-client/${worker?'worker':'in-page'}.json`,JSON.stringify({worker,playerId:p.id,artifactDigest:manifest.artifactFingerprint.digest,actualReleaseSignAdvanceCommands:true,namedSaveReplacementLoadReload:true,row,wagesAndCapRestored:true,annualDefaultChanged:false},null,2)+'\n');
});
