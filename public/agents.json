  "measurablesGlossary": {
    "url": "https://playfranchisearchitect.com/guides.html#measurables",
    "basis": "Size is scored against each position's live league centre, not a fixed chart.",
    "terms": {
      "reach": "Wingspan and arm length, against the position.",
      "handSize": "Thumb to little finger; ball security and contested catches.",
      "frame": "Long, Power, Tower, Compact, Lean, Thick or Prototype, from height, weight and reach against the position.",
      "ras": "Relative Athletic Score, 0-10: size and combine drills as percentiles against the position, averaged.",
      "speedScore": "weight * 200 / forty^4; about 100 is average for a running back.",
      "catchRadiusInches": "Standing reach plus vertical jump."
    }
  }
