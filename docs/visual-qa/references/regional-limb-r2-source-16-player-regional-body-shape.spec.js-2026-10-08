import {test,expect} from '@playwright/test';
import fs from 'node:fs/promises';
import {playerAppearance,playerFrame} from '../src/domain/playerIdentity.js';
import {ensurePlayerVisualIdentity} from '../src/domain/playerVisualIdentity.js';
import {resolveBodyVolume} from '../src/domain/playerMeasurements.js';
import {createPlayScenario} from './helpers/weekly-scenarios.js';

test('equal-size regional body profiles visibly differ with fixed face and skeleton',async({page})=>{
  const phase=process.env.REGIONAL_BODY_CAPTURE_PHASE||'after';
  if(phase==='before')await page.route('**/lib/playerPortrait.js',async route=>route.fulfill({contentType:'text/javascript',body:await fs.readFile('.cache/regional-body-shape-before/playerPortrait.js.txt','utf8')}));
  await page.goto('/');await expect(page.locator('#setupStatus')).toContainText('Ready');
  const base=ensurePlayerVisualIdentity({id:'regional-control',age:24,heightInches:74,weightLbs:225,armLengthInches:33,handLengthInches:8,wingspanInches:78,ratings:{strength:70,speed:80},profile:{}},{newPlayer:true}),f=playerFrame(base),appearance=playerAppearance(base);
  const baseline={trunkShare:.46,armsShare:.10,neckShare:.015,waistBaseline:.77,depthRatio:.70};
  const cases=[['Less arm allocation',{armsShare:.08}],['More arm allocation',{armsShare:.12}],['Tapered waist',{waistBaseline:.68}],['Fuller waist',{waistBaseline:.86}],['Broad shallow chest',{depthRatio:.62}],['Narrow deeper chest',{depthRatio:.78}]];
  const players=cases.map(([name,change])=>{
    const bodyShape=phase==='after'?{...baseline,...change}:null;
    const volume=resolveBodyVolume({height:74,weight:225,shoulderSpan:f.shoulderSpanInches,torsoShare:f.torsoShare,armLength:33,handLength:8,individuality:f.limbShapeVariation,anatomy:f,bodyShape});
    return {...base,name,appearance,visualFrame:{...f,...volume}};
  });
  await page.evaluate(async players=>{
    const {buildPlayerPhysiqueSvg,buildPlayerMotionSvg}=await import('/lib/playerPortrait.js');
    const gallery=document.createElement('section');gallery.id='regionalGallery';gallery.style.cssText='display:grid;gap:16px;padding:16px;max-width:1200px;margin:auto;color:var(--ink-strong);background:var(--surface)';
    for(const [i,p]of players.entries()){
      const card=document.createElement('article');card.dataset.case=i;card.innerHTML=`<h3>${p.name}</h3><div style="display:flex">${buildPlayerPhysiqueSvg(p,{view:'front',idSuffix:`-${i}`})}${buildPlayerPhysiqueSvg(p,{view:'side',idSuffix:`-${i}`})}${buildPlayerMotionSvg(p,{mode:'run',phase:.37,idSuffix:`-${i}`})}</div>`;
      card.querySelectorAll('svg').forEach(svg=>svg.style.cssText='width:33.33%;height:auto;display:block;align-self:start');gallery.append(card);
    }document.body.replaceChildren(gallery);
  },players);
  await fs.mkdir('output/playwright',{recursive:true});
  for(const [viewport,width,height]of[['desktop',1440,1000],['mobile',390,844]]){
    await page.setViewportSize({width,height});await page.locator('#regionalGallery').evaluate((g,cols)=>g.style.gridTemplateColumns=`repeat(${cols},minmax(0,1fr))`,viewport==='desktop'?2:1);
    for(const theme of ['dark','light']){
      await page.evaluate(async t=>(await import('/lib/themeCustomizer.js')).applyTheme(t),theme);
      await page.locator('#regionalGallery').screenshot({path:`output/playwright/s117-regional-body-${phase}-${viewport}-${theme}-gallery.png`});
    }
  }
});

test('real generated body shape remains on dossier and movement after restoration',async({page})=>{
  await createPlayScenario(page);for(const id of ['#firstDebriefDecline','#tutSkipBtn'])if(await page.locator(id).isVisible())await page.locator(id).click();
  const id='P2026-BUF-LB-33468504',response=await page.request.get(`/api/player?playerId=${id}`),{profile}=await response.json();
  expect(profile.player.profile.regionalBodyShapeRecipe.version).toBe('regional-body-shape-v4');
  await page.click('[data-testid="tab-roster"]');await page.click('#loadRosterBtn');await page.locator(`#rosterTable button[data-player-id="${id}"]`).click();
  await page.locator('.player-physique > summary').click();await page.locator('.player-physique-side > summary').click();await page.locator('.player-movement > summary').click();
  await page.emulateMedia({reducedMotion:'reduce'});
  for(const [viewport,width,height]of[['desktop',1440,1000],['mobile',390,844]]){
    await page.setViewportSize({width,height});if(viewport==='mobile'){await expect(page.locator('#mlFullViewBtn')).toBeVisible();await page.locator('#mlFullViewBtn').click();}
    for(const theme of ['dark','light']){
      await page.evaluate(async t=>(await import('/lib/themeCustomizer.js')).applyTheme(t),theme);await expect(page.locator('#mobileLoopOverlay')).toBeHidden();await expect(page.locator('#toastStack .toast')).toHaveCount(0,{timeout:10000});
      for(const [view,selector]of [['front','.player-physique-svg'],['side','.player-physique-side-svg'],['movement','.player-motion-svg']]){
        await page.locator(selector).scrollIntoViewIfNeeded();await page.screenshot({path:`output/playwright/s117-regional-body-after-${viewport}-${theme}-${view}.png`});
      }
    }
  }
  await page.reload();await expect(page.locator('#statusChip')).toContainText('Ready',{timeout:60000});
  const restored=await page.request.get(`/api/player?playerId=${id}`);expect((await restored.json()).profile.player.visualFrame).toEqual(profile.player.visualFrame);
});
