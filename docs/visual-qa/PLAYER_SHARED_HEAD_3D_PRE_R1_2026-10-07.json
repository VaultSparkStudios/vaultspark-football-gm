  "primaryOriginalsInspected": 6,
  "repairs": [
    "Continuous cubic breadth tangents remove the authored-station shading bands.",
    "Shifted lower-jaw geometry and a neck/training-top junction repair the detached bulb-like neck.",
    "Indexed vertices and bounded tessellation reduce the prototype geometry payload.",
    "Tapered hanging locks and compact coil masses replace upright ellipsoid spikes.",
    "Nostril placement follows the same saved nose dimensions used in mesh geometry."
  ],
  "verifiedFoundation": [
    "One indexed mesh per saved individual supplies front and true-profile cameras.",
    "Camera rotation and blinking leave the vertex array unchanged.",
    "Open/closed/open blink restores the same pixels exactly for six exported people.",
    "Finite unit normals, index bounds and outward front normals checked independently of browser screenshots.",
    "Pigment-only changes preserve positions, normals and topology.",
    "Invalid tessellation is rejected before an unbounded mesh allocation."
  ],
  "remainingDefects": [
    "Plastic/low-detail skin and simplified facial material remain below the adult-person art target.",
    "Grooming approximations omit complete saved hairstyle, strand, arrangement, gray and dye coverage; no full trait-consumption claim.",
    "Eyes and eyelids remain material patterns on a simple surface; detailed anatomical quality remains open.",
    "Projection quality and coherent geometry do not establish real-world anthropometry or ancestry probabilities.",
    "Prototype is not connected to the actual dossier, roster, draft, moving measured body, accessibility fallback or save decoder.",
    "Production readiness requires context-loss/resource lifecycle, bounded caching, actual UI/mobile performance and persistence checks."
  ],
  "decision": "Retain and develop the common geometric foundation; do not ship or label the appearance overhaul complete.",
  "independentReview": "pending",
  "blockingDefectsOpen": 1,
