// Encoded PNG bytes can contain the literal letters NaN. Validate that payload
// separately, then keep the non-finite check on every remaining SVG attribute.
async function motionGeometryMarkup(locator){
 return locator.evaluate(element=>{
  const clone=element.cloneNode(true);
  for(const image of clone.querySelectorAll('image'))for(const name of ['href','xlink:href']){
   const value=image.getAttribute(name);
   if(!value?.startsWith('data:image/png;base64,'))continue;
   if(!/^data:image\/png;base64,[A-Za-z0-9+/]+={0,2}$/.test(value))throw Error('Malformed encoded head image');
   const bytes=atob(value.slice('data:image/png;base64,'.length));
   if([...bytes.slice(0,8)].map(c=>c.charCodeAt(0)).join(',')!=='137,80,78,71,13,10,26,10')throw Error('Invalid PNG signature');
   image.setAttribute(name,'validated-encoded-png');
  }
  return clone.innerHTML;
 });
}
